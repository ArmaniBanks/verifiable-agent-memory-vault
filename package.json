{
  "name": "verifiable-agent-memory-vault",
  "version": "0.1.0",
  "private": true,
  "description": "0G APAC Hackathon MVP for verifiable AI agent memory, logs, and proof verification.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:0g": "hardhat run scripts/deploy.js --network ogMainnet",
    "rpc:proxy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rpc-proxy.ps1",
    "storage:proxy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rpc-proxy.ps1 -ListenPrefix http://127.0.0.1:18546/ -TargetUrl https://indexer-storage-turbo.0g.ai",
    "verify:0g": "hardhat verify --network ogMainnet"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.6",
    "ethers": "6.13.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-verify": "2.0.11",
    "@types/node": "^20.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "hardhat": "^2.22.19",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
